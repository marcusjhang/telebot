# .env.example
# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=random_secret_string_for_webhook_verification

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=your_random_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://yourdomain.vercel.app"]

# Web App
WEB_APP_URL=http://localhost:3000

# Telegram Webhook
TELEGRAM_WEBHOOK_URL=https://your-app.railway.app
TELEGRAM_WEBHOOK_SECRET=your-random-secret-32-chars

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

# Sentry (optional)
SENTRY_DSN=

